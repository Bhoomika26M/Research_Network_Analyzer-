PROJECT_NAME="Scientific Collaboration Network API"
API_V1_STR="/api/v1"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=4320 # 3 days

# ⚠️ SENSITIVE — change all values below before deploying to production

# JWT signing secret (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Database PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_DB=scicollab_db
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password-here@localhost:5432/scicollab_db

# Redis Caching & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Seed data — default password for demo/seeded accounts
SEED_USER_PASSWORD=your-seed-password-here

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:8443","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:8443"]
