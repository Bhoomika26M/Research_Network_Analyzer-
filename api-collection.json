    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\", \"full_name\": \"{{full_name}}\", \"role\": \"{{role}}\"}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/auth/register",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", json.access_token);",
                  "pm.collectionVariables.set(\"refresh_token\", json.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "description": "email address"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "description": "Password123!"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/auth/login",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", json.access_token);",
                  "pm.collectionVariables.set(\"refresh_token\", json.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
